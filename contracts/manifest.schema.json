{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acl.pt/contracts/publication-manifest/v1",
  "title": "Manifesto de publicação ACL",
  "type": "object",
  "required": [
    "release_id",
    "state",
    "contract_version",
    "generator_version",
    "counts",
    "files"
  ],
  "properties": {
    "release_id": {"type": "string", "minLength": 1},
    "state": {
      "enum": ["prepared", "validated", "indexed", "tested", "active", "archived"]
    },
    "contract_version": {"const": "1"},
    "generator_version": {"type": "string"},
    "counts": {
      "type": "object",
      "required": ["entries", "dictionary", "vocabulary"],
      "properties": {
        "entries": {"type": "integer", "minimum": 0},
        "dictionary": {"type": "integer", "minimum": 0},
        "vocabulary": {"type": "integer", "minimum": 0}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}

